{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "allowJs": true,
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["astro/client"]
  },
  "include": ["src/**/*", "src/ts/**/*"]
}
