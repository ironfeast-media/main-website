---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
}

const { src, alt, width, height } = Astro.props;
---

<Image 
  src={src} 
  alt={alt}
  width={width || 1200}
  height={height || 600}
  format="webp"
  quality={80}
  loading="lazy"
/>